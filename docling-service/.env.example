# Shared secret required by the private extraction endpoint outside local development.
DOCLING_SHARED_SECRET=replace-with-a-local-secret

# Keep false unless this service is explicitly being run for local development.
DOCLING_ALLOW_INSECURE_LOCAL=false

# Application-level upload limits in bytes.
DOCLING_MAX_UPLOAD_BYTES=52428800
DOCLING_MAX_MULTIPART_OVERHEAD_BYTES=1048576
