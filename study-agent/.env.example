# Study worker (eve)

DATABASE_URL=
DATABASE_SSL=true
PG_POOL_MAX=1
# Required. HS256 secret for study-worker JWTs; there is no fallback to the
# app auth secret. Must match the value used by the stitch-app server to sign
# tokens (see stitch-app/.env.example).
STUDY_WORKER_JWT_SECRET=
AI_GATEWAY_API_KEY=
